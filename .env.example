# awf-skills — credential template.
#
# Copy to one of:
#   <project_root>/.env       (per-project override; rare)
#   $AWF_HOME/.env            (this checkout; usually empty)
#   ~/.config/awf/.env        (user-global; recommended location)
#
# Resolution order (first match wins, per-key):
#   process env  >  ./.env  >  $AWF_HOME/.env  >  ~/.config/awf/.env
#
# Run `awf-doctor` to see which file each var resolved from.

# ── Cloudflare API ──────────────────────────────────────────────────────────
CLOUDFLARE_EMAIL=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare Pages deploys use `wrangler` CLI auth (separate). Run:
#   wrangler login
# `awf-doctor` verifies via `wrangler whoami`.

# ── Namecheap ───────────────────────────────────────────────────────────────
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=

# ── Fathom Analytics ────────────────────────────────────────────────────────
FATHOM_API_KEY=

# ── Google (Search Console + Site Verification) ─────────────────────────────
# Path to the OAuth desktop-client JSON downloaded from GCP.
GOOGLE_APPLICATION_CREDENTIALS=

# token.json (cached refresh token) is written next to the project or in
# $AWF_HOME on first OAuth run. Never set as an env var.

# ── Bing IndexNow ───────────────────────────────────────────────────────────
# Per-domain key lives in passport.json#indexnow_key, generated by
# awf-submit-bing on first run. There is no BING_INDEXNOW_KEY env var.
